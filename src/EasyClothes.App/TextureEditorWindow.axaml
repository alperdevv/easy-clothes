<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="using:EasyClothes.App.Viewer"
        xmlns:ui="using:EasyClothes.App.Controls"
        xmlns:vm="using:EasyClothes.App.ViewModels"
        x:Class="EasyClothes.App.TextureEditorWindow"
        x:DataType="vm:TextureEditorViewModel" Icon="/Assets/icon.ico"
        Title="{Binding Title}" Width="1500" Height="900" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+N" Command="{Binding NewLayerCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding DuplicateLayerCommand}" />
    <KeyBinding Gesture="Ctrl+E" Command="{Binding MergeDownCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TextBlock.undone">
      <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="WrapPanel.buttons > Button">
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <!-- The visibility eye: no checked tint, the icon already says it. -->
    <Style Selector="ToggleButton.eye:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="ToggleButton.eye">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Foreground" Value="{StaticResource SubtleBrush}" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="flat" Click="OnCancel">
            <ui:IconLabel Icon="{StaticResource Icon.X}" Text="Cancelar" />
          </Button>
          <Button Command="{Binding ApplyCommand}" Classes="accent">
            <ui:IconLabel Icon="{StaticResource Icon.Check}" Text="Aplicar…" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="3">
            <StackPanel Classes="group">
              <ToggleButton Classes="flat" IsChecked="{Binding IsMoveTool}" ToolTip.Tip="Mover la capa o la imagen seleccionada (V)">
                <ui:IconLabel Icon="{StaticResource Icon.Move}" Text="Mover" />
              </ToggleButton>
              <ToggleButton Classes="flat" IsChecked="{Binding IsBrushTool}" ToolTip.Tip="Pintar en la capa seleccionada (B). Alt+clic toma un color">
                <ui:IconLabel Icon="{StaticResource Icon.Paintbrush}" Text="Pincel" />
              </ToggleButton>
              <ToggleButton Classes="flat" IsChecked="{Binding IsEraserTool}" ToolTip.Tip="Borrar en la capa seleccionada (E)">
                <ui:IconLabel Icon="{StaticResource Icon.Eraser}" Text="Borrador" />
              </ToggleButton>
              <ToggleButton Classes="flat" IsChecked="{Binding IsEraseMarkTool}" ToolTip.Tip="Tapar un logo o una marca con otra zona de la misma prenda (S)">
                <ui:IconLabel Icon="{StaticResource Icon.Stamp}" Text="Borrar marca" />
              </ToggleButton>
              <ToggleButton Classes="flat" IsChecked="{Binding IsHandTool}" ToolTip.Tip="Desplazar la vista (H, o mantén Espacio)">
                <ui:IconLabel Icon="{StaticResource Icon.Hand}" Text="Mano" />
              </ToggleButton>
            </StackPanel>
          </Border>
          <Rectangle Classes="separator" />
          <StackPanel Classes="group">
            <Button Classes="flat square" Command="{Binding UndoCommand}" ToolTip.Tip="Deshacer (Ctrl+Z)">
              <ui:Icon Data="{StaticResource Icon.Undo2}" />
            </Button>
            <Button Classes="flat square" Command="{Binding RedoCommand}" ToolTip.Tip="Rehacer (Ctrl+Y)">
              <ui:Icon Data="{StaticResource Icon.Redo2}" />
            </Button>
            <Button Classes="flat" Command="{Binding ResetAllCommand}" ToolTip.Tip="Vuelve a como estaba la textura al abrir el editor">
              <ui:IconLabel Icon="{StaticResource Icon.RotateCcw}" Text="Restablecer" />
            </Button>
          </StackPanel>
          <Rectangle Classes="separator" />
          <Button Classes="flat" Command="{Binding OpenExternalCommand}"
                  ToolTip.Tip="Abre la textura como PNG en tu editor de imágenes; al guardar allí vuelve aquí como una capa nueva">
            <ui:IconLabel Icon="{StaticResource Icon.ExternalLink}" Text="Editar en Photoshop/GIMP" />
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="bar" BorderThickness="0,0,0,1" Padding="12,4">
      <Panel>
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsPaintTool}">
          <ColorPicker Color="{Binding BrushColor}" IsAlphaVisible="False" />
          <TextBlock Classes="muted" Text="{Binding BrushSize, StringFormat='Tamaño {0:0} px'}" Width="90" />
          <Slider Minimum="1" Maximum="512" Value="{Binding BrushSize}" Width="140" />
          <TextBlock Classes="muted" Text="{Binding BrushHardness, StringFormat='Dureza {0:0} %'}" Width="80" />
          <Slider Minimum="0" Maximum="100" Value="{Binding BrushHardness}" Width="110" />
          <TextBlock Classes="muted" Text="{Binding BrushOpacity, StringFormat='Opacidad {0:0} %'}" Width="96" />
          <Slider Minimum="1" Maximum="100" Value="{Binding BrushOpacity}" Width="110" />
          <TextBlock Classes="muted" Text="[ y ] cambian el tamaño · Alt+clic: cuentagotas" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMoveTool}" Margin="0,7">
          <ui:Icon Classes="muted" Size="14" Data="{StaticResource Icon.Info}" />
          <TextBlock Classes="muted" Text="Arrastra para mover la capa seleccionada; clic sobre una imagen la selecciona. Ctrl+rueda cambia su tamaño." />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEraseMarkTool}">
          <ui:Icon Classes="muted" Size="14" Data="{StaticResource Icon.Info}" VerticalAlignment="Center" />
          <TextBlock Classes="muted" VerticalAlignment="Center"
                     Text="Arrastra un rectángulo sobre la marca, con algo de margen: se tapa con la zona de la prenda que mejor encaja, en una capa nueva." />
          <Button Classes="flat" Command="{Binding TryAnotherSourceCommand}" ToolTip.Tip="Tapar la última marca con la siguiente zona que mejor encaja">
            <ui:IconLabel Icon="{StaticResource Icon.RotateCcw}" Text="Otra zona" />
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsHandTool}" Margin="0,7">
          <ui:Icon Classes="muted" Size="14" Data="{StaticResource Icon.Info}" />
          <TextBlock Classes="muted" Text="Arrastra para desplazar la vista. La rueda hace zoom; Ctrl+0 ajusta y Ctrl+1 muestra a tamaño real." />
        </StackPanel>
      </Panel>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
          <Button Classes="flat square" Click="OnZoomOut" ToolTip.Tip="Alejar (Ctrl+-)">
            <ui:Icon Size="14" Data="{StaticResource Icon.ZoomOut}" />
          </Button>
          <TextBlock Classes="muted" Text="{Binding ZoomPercent, StringFormat='{}{0:0} %'}" MinWidth="46" TextAlignment="Center" />
          <Button Classes="flat square" Click="OnZoomIn" ToolTip.Tip="Acercar (Ctrl++)">
            <ui:Icon Size="14" Data="{StaticResource Icon.ZoomIn}" />
          </Button>
          <Button Classes="flat square" Click="OnFit" ToolTip.Tip="Ajustar a la ventana (Ctrl+0)">
            <ui:Icon Size="14" Data="{StaticResource Icon.Maximize}" />
          </Button>
          <Button Classes="flat small" Content="100 %" Click="OnActualPixels" ToolTip.Tip="Tamaño real (Ctrl+1)" />
          <Border Background="{StaticResource HoverBrush}" CornerRadius="9" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Classes="muted" FontSize="11" Text="{Binding SizeLabel}" />
          </Border>
        </StackPanel>
        <TextBlock Classes="muted" Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="*,1,0.7*,1,320">
      <viewer:TextureCanvas x:Name="Canvas" ClipToBounds="True" Focusable="True" />

      <GridSplitter Grid.Column="1" />

      <Panel Grid.Column="2">
        <viewer:MeshViewport x:Name="Viewport" />
        <Border Classes="overlay" HorizontalAlignment="Left" VerticalAlignment="Top">
          <ui:IconLabel Classes="section" Margin="0" Icon="{StaticResource Icon.Eye}" Text="VISTA PREVIA" />
        </Border>
      </Panel>

      <GridSplitter Grid.Column="3" />

      <Border Grid.Column="4" Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto,Auto,1.3*,Auto,130">
          <ui:IconLabel Classes="section" Margin="14,12,12,6" Icon="{StaticResource Icon.Layers}" Text="CAPAS" />
          <ListBox Grid.Row="1" x:Name="LayerList" Classes="compact" ItemsSource="{Binding Layers}" SelectedItem="{Binding SelectedLayer}" Margin="8,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LayerViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <ToggleButton Classes="flat eye" IsChecked="{Binding Visible}" Margin="0,0,6,0" ToolTip.Tip="Mostrar u ocultar">
                    <Panel>
                      <ui:Icon Size="15" Data="{StaticResource Icon.Eye}" IsVisible="{Binding Visible}" />
                      <ui:Icon Size="15" Data="{StaticResource Icon.EyeOff}" IsVisible="{Binding !Visible}" />
                    </Panel>
                  </ToggleButton>
                  <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ui:Icon Classes="muted" Size="13" Data="{StaticResource Icon.Lock}" IsVisible="{Binding Locked}" />
                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Kind}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <StackPanel Grid.Row="2" Margin="12,8,12,0" Spacing="4">
            <WrapPanel Classes="buttons">
              <Button Command="{Binding NewLayerCommand}" ToolTip.Tip="Capa vacía para pintar (Ctrl+Mayús+N)">
                <ui:IconLabel Icon="{StaticResource Icon.Plus}" IconSize="14" Spacing="5" Text="Capa" />
              </Button>
              <Button Command="{Binding NewFillLayerCommand}" ToolTip.Tip="Capa de un color sólido">
                <ui:IconLabel Icon="{StaticResource Icon.PaintBucket}" IconSize="14" Spacing="5" Text="Relleno" />
              </Button>
              <Button Command="{Binding NewAdjustmentLayerCommand}" ToolTip.Tip="Tono, saturación, brillo... de lo que hay debajo">
                <ui:IconLabel Icon="{StaticResource Icon.SlidersHorizontal}" IconSize="14" Spacing="5" Text="Ajuste" />
              </Button>
              <Button Command="{Binding AddImageCommand}" ToolTip.Tip="Logo, parche o cualquier PNG/YTD">
                <ui:IconLabel Icon="{StaticResource Icon.Image}" IconSize="14" Spacing="5" Text="Imagen…" />
              </Button>
            </WrapPanel>
            <Border Background="{StaticResource WindowBrush}" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
              <StackPanel Classes="group">
                <Button Classes="flat square" Command="{Binding DuplicateLayerCommand}" ToolTip.Tip="Duplicar (Ctrl+J)">
                  <ui:Icon Size="15" Data="{StaticResource Icon.Copy}" />
                </Button>
                <Button Classes="flat square" Command="{Binding MergeDownCommand}" ToolTip.Tip="Combinar con la de abajo (Ctrl+E)">
                  <ui:Icon Size="15" Data="{StaticResource Icon.Merge}" />
                </Button>
                <Button Classes="flat square" Command="{Binding RasterizeLayerCommand}" ToolTip.Tip="Rasterizar: convierte la capa en píxeles para poder pintar en ella">
                  <ui:Icon Size="15" Data="{StaticResource Icon.Grid3x3}" />
                </Button>
                <Button Classes="flat square" Command="{Binding MoveLayerUpCommand}" ToolTip.Tip="Subir">
                  <ui:Icon Size="15" Data="{StaticResource Icon.ChevronUp}" />
                </Button>
                <Button Classes="flat square" Command="{Binding MoveLayerDownCommand}" ToolTip.Tip="Bajar">
                  <ui:Icon Size="15" Data="{StaticResource Icon.ChevronDown}" />
                </Button>
                <Button Classes="flat square danger" Command="{Binding DeleteLayerCommand}" ToolTip.Tip="Eliminar (Supr)">
                  <ui:Icon Size="15" Data="{StaticResource Icon.Trash2}" />
                </Button>
              </StackPanel>
            </Border>
          </StackPanel>

          <ui:IconLabel Grid.Row="3" Classes="section" Margin="14,14,12,2" Icon="{StaticResource Icon.SlidersHorizontal}" Text="PROPIEDADES" />
          <ScrollViewer Grid.Row="4">
            <StackPanel>
              <StackPanel Classes="form" DataContext="{Binding SelectedLayer}" x:DataType="vm:LayerViewModel"
                          IsVisible="{Binding $parent[Window].((vm:TextureEditorViewModel)DataContext).HasSelectedLayer}">
                <TextBlock Classes="label" Text="Nombre" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" />
                <TextBlock Classes="label" Text="Modo de fusión" />
                <ComboBox ItemsSource="{x:Static vm:LayerViewModel.BlendNames}" SelectedIndex="{Binding BlendIndex}" HorizontalAlignment="Stretch" />
                <TextBlock Classes="label" Text="{Binding Opacity, StringFormat='Opacidad: {0:0} %'}" />
                <Slider Minimum="0" Maximum="100" Value="{Binding Opacity}" />
                <CheckBox Content="Bloquear capa" IsChecked="{Binding Locked}" />

                <StackPanel IsVisible="{Binding IsImage}">
                  <TextBlock Classes="label" Text="{Binding Size, StringFormat='Tamaño: {0:0} % del ancho'}" />
                  <Slider Minimum="1" Maximum="400" Value="{Binding Size}" />
                  <TextBlock Classes="label" Text="{Binding Rotation, StringFormat='Rotación: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Rotation}" />
                </StackPanel>

                <DockPanel IsVisible="{Binding IsFill}" Margin="0,8,0,0">
                  <ColorPicker DockPanel.Dock="Right" Color="{Binding FillColor}" IsAlphaVisible="False" />
                  <TextBlock Classes="label" Text="Color" VerticalAlignment="Center" Margin="0" />
                </DockPanel>

                <StackPanel IsVisible="{Binding IsAdjustment}">
                  <TextBlock Classes="label" Text="{Binding Hue, StringFormat='Tono: {0:0}°'}" />
                  <Slider Minimum="-180" Maximum="180" Value="{Binding Hue}" />
                  <TextBlock Classes="label" Text="{Binding Saturation, StringFormat='Saturación: {0:0}'}" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Saturation}" />
                  <TextBlock Classes="label" Text="{Binding Brightness, StringFormat='Brillo: {0:0}'}" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Brightness}" />
                  <TextBlock Classes="label" Text="{Binding Contrast, StringFormat='Contraste: {0:0}'}" />
                  <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast}" />
                  <TextBlock Classes="label" Text="{Binding TintStrength, StringFormat='Tinte: {0:0} %'}" />
                  <DockPanel>
                    <ColorPicker DockPanel.Dock="Right" Color="{Binding TintColor}" Margin="8,0,0,0" IsAlphaVisible="False" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding TintStrength}" />
                  </DockPanel>
                </StackPanel>
              </StackPanel>

              <StackPanel Classes="form" IsVisible="{Binding HasOriginal}">
                <CheckBox IsChecked="{Binding KeepOriginalAlpha}">
                  <TextBlock TextWrapping="Wrap" Text="Mantener la transparencia (recorte) de la textura original" />
                </CheckBox>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ui:IconLabel Grid.Row="5" Classes="section" Margin="14,12,12,4" Icon="{StaticResource Icon.History}" Text="HISTORIAL" />
          <ListBox Grid.Row="6" Classes="compact" ItemsSource="{Binding HistoryItems}" SelectedIndex="{Binding HistoryIndex}" Margin="8,0,8,10">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:HistoryItemViewModel">
                <TextBlock Text="{Binding Label}" Classes.undone="{Binding IsUndone}" FontSize="12" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>
</Window>
