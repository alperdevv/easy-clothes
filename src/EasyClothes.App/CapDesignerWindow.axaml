<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewer="using:EasyClothes.App.Viewer"
        xmlns:vm="using:EasyClothes.App.ViewModels"
        x:Class="EasyClothes.App.CapDesignerWindow"
        x:DataType="vm:CapDesignerViewModel" Icon="/Assets/icon.ico"
        Title="{Binding Title}" Width="1100" Height="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
  <Window.Styles>
    <Style Selector="Grid.row">
      <Setter Property="Margin" Value="0,2" />
    </Style>
    <Style Selector="Grid.row > TextBlock.value">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ColorPicker">
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Classes="bar" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Content="Cancelar" Click="OnCancel" />
          <Button Content="Crear gorra" Classes="accent" IsVisible="{Binding IsNew}" Command="{Binding CreateCommand}" />
          <Button Content="Guardar colores como textura nueva" IsVisible="{Binding IsEditing}" Command="{Binding AddColoursCommand}"
                  ToolTip.Tip="Añade otra variación de color (b, c…) con estos colores; las que ya tienes no cambian" />
          <Button Content="Aplicar forma" Classes="accent" IsVisible="{Binding IsEditing}" Command="{Binding ReshapeCommand}"
                  ToolTip.Tip="Cambia el modelo; todas las texturas, también las editadas, siguen encajando" />
        </StackPanel>
        <TextBlock Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding PreviewError}" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="340,4,*">
      <ScrollViewer>
        <StackPanel Classes="form">
          <StackPanel IsVisible="{Binding IsNew}">
            <TextBlock Classes="label" Text="Nombre" />
            <TextBox Text="{Binding Name}" />
            <TextBlock Classes="label" Text="Género" />
            <ComboBox ItemsSource="{x:Static vm:GenderOption.All}" SelectedItem="{Binding Gender}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:GenderOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Classes="small" Content="Restablecer" Command="{Binding ResetShapeCommand}" ToolTip.Tip="Vuelve a la forma de partida sin tocar los colores" />
            <TextBlock Classes="header" Text="FORMA" Margin="0" />
          </DockPanel>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Talla" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="{Binding Size, StringFormat={}{0:0.00}}" />
          </Grid>
          <Slider Minimum="0.9" Maximum="1.1" Value="{Binding Size}" ToolTip.Tip="Lo ajustada que queda a la cabeza" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Alto de la copa" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="{Binding CrownHeight, StringFormat={}{0:0.0} cm}" />
          </Grid>
          <Slider Minimum="8" Maximum="15" Value="{Binding CrownHeight}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Copa" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="redondeada ↔ estructurada" />
          </Grid>
          <Slider Minimum="0" Maximum="1" Value="{Binding CrownShape}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Largo de la visera" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="{Binding VisorLength, StringFormat={}{0:0.0} cm}" />
          </Grid>
          <Slider Minimum="0" Maximum="10" Value="{Binding VisorLength}" ToolTip.Tip="A 0 la gorra no tiene visera" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Curva de la visera" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="plana ↔ curvada" />
          </Grid>
          <Slider Minimum="0" Maximum="1" Value="{Binding VisorCurve}" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Inclinación de la visera" />
            <TextBlock Grid.Column="1" Classes="muted value" Text="{Binding VisorAngle, StringFormat={}{0:0}°}" />
          </Grid>
          <Slider Minimum="-10" Maximum="30" Value="{Binding VisorAngle}" ToolTip.Tip="Grados hacia abajo desde la horizontal" />
          <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
            <CheckBox Content="Del revés" IsChecked="{Binding Backwards}" />
            <CheckBox Content="Botón arriba" IsChecked="{Binding Button}" />
          </StackPanel>

          <TextBlock Classes="header" Text="COLORES" Margin="0,14,0,0" />
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Copa" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding CrownColor}" IsAlphaVisible="False" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Paneles delanteros" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding FrontColor}" IsAlphaVisible="False" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Visera" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding VisorColor}" IsAlphaVisible="False" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Debajo de la visera" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding UnderVisorColor}" IsAlphaVisible="False" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Botón" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding ButtonColor}" IsAlphaVisible="False" />
          </Grid>
          <Grid Classes="row" ColumnDefinitions="*,Auto">
            <TextBlock Classes="label" Text="Costuras" VerticalAlignment="Center" />
            <ColorPicker Grid.Column="1" Color="{Binding StitchColor}" IsAlphaVisible="False" />
          </Grid>
          <TextBlock Classes="muted" TextWrapping="Wrap" Margin="0,12,0,0"
                     Text="Para logos, dibujos o detalles, crea la gorra y edita su textura: la plantilla tiene una zona para cada parte (copa, visera arriba y abajo, botón)." />
        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" />

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Classes="header" Text="VISTA PREVIA" />
        <viewer:MeshViewport x:Name="Viewport" />
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
