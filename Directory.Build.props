<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Shown in Properties > Details on Windows; unsigned programs without it look suspicious to antivirus heuristics. -->
  <PropertyGroup>
    <Version>0.9.1</Version>
    <Product>EasyClothes</Product>
    <Authors>David</Authors>
    <Company>David</Company>
    <Copyright>Copyright (c) 2026 David</Copyright>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
</Project>
